# Parishad Configuration
DATABASE_URL=sqlite+aiosqlite:///./parishad.db
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ingestion Connectors (optional)
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
JIRA_BASE_URL=
JIRA_API_TOKEN=
JIRA_USER_EMAIL=
GDRIVE_CREDENTIALS_JSON=

# Security
SECRET_KEY=parishad-dev-secret-change-in-production
ADMIN_API_KEY=parishad-admin-key

# Parishad Review Specialist (Local Fine-Tuned Model)
PARISHAD_LOCAL_SUMMARY_ENABLED=false
PARISHAD_LOCAL_MODEL_PATH=training/saved_model
PARISHAD_LOCAL_INFERENCE_DEVICE=auto
PARISHAD_LOCAL_TIMEOUT_SECONDS=15.0
PARISHAD_LOCAL_MAX_NEW_TOKENS=1536
